{
  "version": "8.1.1",
  "name": "svl",
  "description": "Street Vector Layer (SVL)\r The Road layer for the Waze editors, made by editors.",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/toastr": "^2.1.43",
    "rollup": "^4.64.12",
    "tslib": "^2.7.0",
    "typescript": "^5.6.3",
    "wme-sdk-typings": "https://web-assets.waze.com/wme_sdk_docs/beta/latest/wme-sdk-typings.tgz"
  },
  "scripts": {
    "compile": "rollup -c",
    "watch": "rollup -c --watch",
    "concat": "cross-env concat -o releases\\release-%npm_package_version%.user.js header.js .out/main.user.js",
    "build": "npm run compile && npm run concat",
    "release": "node -e \"const fs=require('fs');fs.writeFileSync('header.js',fs.readFileSync('header.js','utf8').replace(/\\d+\\.\\d+\\.\\d+/,process.env.npm_package_version))\" && cross-env NODE_ENV=production npm run build"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "@types/tampermonkey": "^5.0.3",
    "concat": "^1.0.3",
    "cross-env": "^7.0.3",
    "proj4": "^2.19.10",
    "sweetalert2": "^11.26.18",
    "toastr": "^2.1.4"
  }
}